<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>NEXUS CRM - Nos utilisateurs</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  @!include('partials/topbar')
  <div class="layout">
    @!include('partials/sidebar')
    <main class="content">
      <div class="page-header">
        <div>
          <h1><i class="ti ti-users"></i> Nos utilisateurs</h1>
          <p class="subtitle">Gérez les accès, les rôles et le statut de vos collaborateurs.</p>
        </div>
        <a href="/admin/utilisateurs/creer" class="btn-primary"><i class="ti ti-user-plus"></i> Nouvel utilisateur</a>
      </div>

      @if(flashMessages.get('success'))
        <div class="alert-success">{{ flashMessages.get('success') }}</div>
      @end
      @if(flashMessages.get('error'))
        <div class="alert-error">{{ flashMessages.get('error') }}</div>
      @end

      <div class="stats-grid stats-grid-4">
        <div class="stat-card">
          <span class="pill pill-violet">TOTAL UTILISATEURS</span>
          <div class="value">{{ stats.total }}</div>
        </div>
        <div class="stat-card">
          <span class="pill pill-teal">COMPTES ACTIFS</span>
          <div class="value">{{ stats.actifs }}</div>
        </div>
        <div class="stat-card">
          <span class="pill pill-blue">COMMERCIAUX</span>
          <div class="value">{{ stats.commerciaux }}</div>
        </div>
        <div class="stat-card">
          <span class="pill {{ stats.inactifs > 0 ? 'pill-red' : 'pill-gray' }}">COMPTES INACTIFS</span>
          <div class="value">{{ stats.inactifs }}</div>
        </div>
      </div>

      <form method="GET" action="/admin/utilisateurs" class="filters-row">
        <div class="search-input">
          <i class="ti ti-search"></i>
          <input type="text" name="search" value="{{ filters.search }}" placeholder="Rechercher un utilisateur par nom, email...">
        </div>

        <select name="role" onchange="this.form.submit()">
          <option value="all" {{ filters.role === 'all' ? 'selected' : '' }}>Tous les rôles</option>
          <option value="commercial" {{ filters.role === 'commercial' ? 'selected' : '' }}>Commerciaux</option>
          <option value="admin" {{ filters.role === 'admin' ? 'selected' : '' }}>Administrateurs</option>
        </select>

        <select name="statut" onchange="this.form.submit()">
          <option value="all" {{ filters.statut === 'all' ? 'selected' : '' }}>Tous les statuts</option>
          <option value="actif" {{ filters.statut === 'actif' ? 'selected' : '' }}>Actifs uniquement</option>
          <option value="inactif" {{ filters.statut === 'inactif' ? 'selected' : '' }}>Inactifs uniquement</option>
        </select>

        <button type="submit" class="btn-secondary"><i class="ti ti-filter"></i> Filtrer</button>
        @if(filters.search || filters.role !== 'all' || filters.statut !== 'all')
          <a href="/admin/utilisateurs" class="btn-outline">Réinitialiser</a>
        @end
      </form>

      <div class="panel">
        <div class="panel-header">
          <h3>Liste des utilisateurs ({{ users.length }})</h3>
        </div>
        <table class="contacts-table" style="table-layout: auto;">
          <thead>
            <tr>
              <th>Utilisateur</th>
              <th>Rôle</th>
              <th>Statut</th>
              <th>Contacts gérés</th>
              <th>Commandes</th>
              <th>Inscrit le</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(u in users)
              <tr>
                <td>
                  <div style="display:flex;align-items:center;gap:12px">
                    <div class="avatar-initials">
                      {{ u.fullName ? u.fullName.split(' ').map(n => n[0]).join('').toUpperCase() : 'U' }}
                    </div>
                    <div>
                      <b>{{ u.fullName }}</b>
                      @if(auth.user.id === u.id)
                        <span class="pill pill-blue" style="font-size:10px;padding:2px 8px;margin-left:4px">VOUS</span>
                      @end
                      <br>
                      <span class="text-muted"><i class="ti ti-mail"></i> {{ u.email }}</span>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="pill {{ u.role === 'admin' ? 'pill-amber' : 'pill-violet' }}">
                    {{ u.role === 'admin' ? 'ADMINISTRATEUR' : 'COMMERCIAL' }}
                  </span>
                </td>
                <td>
                  <span class="pill {{ u.statutCompte === 'actif' ? 'pill-teal' : 'pill-red' }}">
                    {{ u.statutCompte === 'actif' ? 'ACTIF' : 'INACTIF' }}
                  </span>
                </td>
                <td>
                  @if(u.role === 'commercial')
                    <span class="pill {{ u.contactsCount > 0 ? 'pill-teal' : 'pill-gray' }}">
                      {{ u.contactsCount }} contact(s)
                    </span>
                  @else
                    <span class="text-muted">—</span>
                  @end
                </td>
                <td>
                  @if(u.role === 'commercial')
                    <span class="pill {{ u.commandesCount > 0 ? 'pill-violet' : 'pill-gray' }}">
                      {{ u.commandesCount }} commande(s)
                    </span>
                  @else
                    <span class="text-muted">—</span>
                  @end
                </td>
                <td>
                  <span class="text-muted">{{ u.createdAt ? u.createdAt.toFormat('dd/MM/yyyy') : '-' }}</span>
                </td>
                <td class="actions">
                  <a href="/admin/utilisateurs/{{ u.id }}" title="Voir les détails & performances"><i class="ti ti-eye"></i></a>
                  <a href="/admin/utilisateurs/{{ u.id }}/edit" title="Modifier"><i class="ti ti-pencil"></i></a>

                  @if(auth.user.id !== u.id)
                    <form action="/admin/utilisateurs/{{ u.id }}/toggle-statut" method="POST" style="display:inline">
                      {{ csrfField() }}
                      <button type="submit" title="{{ u.statutCompte === 'actif' ? 'Désactiver le compte' : 'Activer le compte' }}">
                        <i class="ti {{ u.statutCompte === 'actif' ? 'ti-user-off' : 'ti-user-check' }}" style="color:{{ u.statutCompte === 'actif' ? 'var(--amber)' : 'var(--teal)' }}"></i>
                      </button>
                    </form>

                    <form action="/admin/utilisateurs/{{ u.id }}/delete" method="POST" style="display:inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ u.fullName }} ?')">
                      {{ csrfField() }}
                      <button type="submit" title="Supprimer">
                        <i class="ti ti-trash" style="color:var(--destructive)"></i>
                      </button>
                    </form>
                  @end
                </td>
              </tr>
            @end

            @if(users.length === 0)
              <tr>
                <td colspan="7" style="text-align:center;padding:48px 16px;color:var(--text-muted)">
                  <i class="ti ti-users-off" style="font-size:36px;display:block;margin-bottom:8px"></i>
                  <b>Aucun utilisateur trouvé</b><br>
                  Ajustez vos filtres ou effectuez une autre recherche.
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
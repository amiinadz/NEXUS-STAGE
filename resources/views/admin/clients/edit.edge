<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>NEXUS CRM - Modifier {{ client.nom }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  @!include('partials/topbar')
  <div class="layout">
    @!include('partials/sidebar')
    <main class="content">
      <div class="page-header">
        <div>
          <h1><i class="ti ti-pencil"></i> Modifier le client</h1>
          <p class="subtitle">{{ client.nom }}</p>
        </div>
      </div>

      <div class="panel" style="max-width:600px">
        <form method="POST" action="/admin/clients/{{ client.id }}/update">
          {{ csrfField() }}

          <label>Nom de l'entreprise *</label>
          <input type="text" name="nom" value="{{ client.nom }}" required>

          <label>Secteur d'activité</label>
          <input type="text" name="secteurActivite" value="{{ client.secteurActivite ?? '' }}">

          <label>Statut</label>
          <select name="statut">
            <option value="client" {{ client.statut === 'client' ? 'selected' : '' }}>Client</option>
            <option value="prospect" {{ client.statut === 'prospect' ? 'selected' : '' }}>Prospect</option>
          </select>

          <label>Commercial assigné</label>
          <select name="commercialId">
            <option value="">-- Aucun (Non assigné) --</option>
            @each(c in commerciaux)
              <option value="{{ c.id }}" {{ client.commercialId === c.id ? 'selected' : '' }}>{{ c.fullName }}</option>
            @end
          </select>

          <label>Email de contact</label>
          <input type="email" name="email" value="{{ client.email ?? '' }}">

          <label>Téléphone</label>
          <input type="text" name="telephone" value="{{ client.telephone ?? '' }}">

          <label>Adresse / Ville</label>
          <input type="text" name="adresse" value="{{ client.adresse ?? '' }}">

          <div style="margin-top:24px;display:flex;gap:12px;align-items:center">
            <button type="submit" class="btn-primary">Enregistrer les modifications</button>
            <a href="/admin/clients" class="btn-secondary">Annuler</a>
          </div>
        </form>
      </div>

      <a href="/admin/clients" class="back-link">← Retour à la liste</a>
    </main>
  </div>
</body>
</html>

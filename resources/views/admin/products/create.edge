<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>NEXUS CRM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  @!include('partials/topbar')
  <div class="layout">
    @!include('partials/sidebar')
    <main class="content">
      <h1>Nouveau produit</h1>

      <div class="panel" style="max-width:520px">
        <form method="POST" action="/admin/produits">
          {{ csrfField() }}
          <label>Nom</label>
          <input type="text" name="nom" required>

          <label>Description</label>
          <textarea name="description" rows="3"></textarea>

          <label>Prix (€)</label>
          <input type="number" step="0.01" name="prix" required>

          <label>Type</label>
          <select name="type">
            <option value="service">Service</option>
            <option value="produit">Produit</option>
          </select>

          <button type="submit" class="btn-primary" style="margin-top:20px">Créer le produit</button>
        </form>
      </div>

      <a href="/admin/produits" class="back-link">← Retour à la liste</a>
    </main>
  </div>
</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>NEXUS CRM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
</head>
<body>
  @!include('partials/topbar')
  <div class="layout">
    @!include('partials/sidebar')
    <main class="content">
      <h1>Bonjour, {{ auth.user.fullName.split(' ')[0] }}</h1>
      <p class="subtitle">Voici un aperçu de la gestion des utilisateurs et de l'organisation.</p>

      <div class="stats-grid stats-grid-4">
        <div class="stat-card">
          <span class="pill pill-teal">UTILISATEURS ACTIFS</span>
          <div class="value">{{ stats.utilisateursActifs }}</div>
        </div>
        <div class="stat-card">
          <span class="pill pill-violet">NOUVEAUX UTILISATEURS</span>
          <div class="value">{{ stats.nouveauxUtilisateurs }}</div>
        </div>
        <div class="stat-card">
          <span class="pill pill-amber">PAR RÔLE</span>
          <div class="value">{{ stats.parRole }}</div>
        </div>
        <div class="stat-card">
          <span class="pill pill-red">COMPTES INACTIFS</span>
          <div class="value">{{ stats.comptesInactifs }}</div>
        </div>
        <div class="stat-card">
          <span class="pill pill-teal">COMMANDES REÇUES</span>
          <div class="value">{{ stats.commandesRecues }}</div>
        </div>
        <div class="stat-card">
          <span class="pill pill-violet">PROSPECTS SUR L'APP</span>
          <div class="value">{{ stats.prospectsApp }}</div>
        </div>
      </div>

      <div class="panels-row cols-3">
        <div class="panel">
          <div class="panel-header"><h3>Utilisateurs par rôle</h3></div>
          <canvas id="rolesDonut" height="180"></canvas>
          <div style="margin-top:16px">
            @each(r in repartitionRoles)
              <div class="legend-item"><span class="legend-dot" style="background:{{ r.color }}"></span><b>{{ r.label }}</b><span class="val">&nbsp;{{ r.count }} ({{ r.value }}%)</span></div>
            @end
          </div>
        </div>

        <div class="panel">
          <div class="panel-header"><h3>Évolution des commandes réussies</h3></div>
          <canvas id="commandesLine" height="150"></canvas>
        </div>

        <div class="panel">
          <div class="panel-header"><h3>Dernière activité</h3><a href="/admin/utilisateurs">Voir tout</a></div>
          @each(u in derniersUsers)
            <div class="activity-item">
              <div class="icon" style="background:var(--violet-light);color:var(--violet)">●</div>
              <div class="text"><b>{{ u.fullName }}</b><br>{{ u.role }} — {{ u.statutCompte }}</div>
              <div class="time">{{ u.updatedAt.toRelative() }}</div>
            </div>
          @end
        </div>
      </div>

      <div class="panels-row cols-2">
        <div class="panel">
          <div class="panel-header"><h3>Meilleurs commerciaux</h3></div>
          <table class="contacts-table">
            <thead><tr><th>Commercial</th><th>Commandes réussies</th></tr></thead>
            <tbody>

              @each((c, index) in meilleursCommerciaux) 
                 <tr>
                    <td><span class="rank-badge">{{ index + 1 }}</span> {{ c.nom }}</td>
                    <td>{{ c.nbCommandes }}</td>
                 </tr>
              @end
              
              @if(meilleursCommerciaux.length === 0)
                <tr><td colspan="2" class="text-muted">Pas encore de données.</td></tr>
              @end
            </tbody>
          </table>
        </div>
        <div class="panel">
          <div class="panel-header"><h3>Produits les plus vendus</h3></div>
          <table class="contacts-table">
            <thead><tr><th>Produit</th><th>Quantité vendue</th></tr></thead>
            <tbody>
              @each(p in produitsVendus)
                <tr>
                  <td>{{ p.nom }}</td>
                  <td>{{ p.qteTotale }}</td>
                </tr>
              @end
              @if(produitsVendus.length === 0)
                <tr><td colspan="2" class="text-muted">Pas encore de données.</td></tr>
              @end
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    new Chart(document.getElementById('rolesDonut'), {
      type: 'doughnut',
      data: {
        labels: {{{ JSON.stringify(repartitionRoles.map(r => r.label)) }}},
        datasets: [{ data: {{{ JSON.stringify(repartitionRoles.map(r => r.value)) }}}, backgroundColor: {{{ JSON.stringify(repartitionRoles.map(r => r.color)) }}}, borderWidth: 0 }]
      },
      options: { cutout: '70%', plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('commandesLine'), {
      type: 'line',
      data: {
        labels: {{{ JSON.stringify(semaines.map(s => s.label)) }}},
        datasets: [{ data: {{{ JSON.stringify(semaines.map(s => s.count)) }}}, borderColor: '#e8643f', backgroundColor: 'rgba(232,100,63,0.1)', fill: true, tension: 0.4 }]
      },
      options: { plugins: { legend: { display: false } } }
    });
  </script>
</body>
</html>
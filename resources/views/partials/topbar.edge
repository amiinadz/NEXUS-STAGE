<nav class="topbar">
  <div class="logo">
    <a href="{{ auth.user && auth.user.role === 'admin' ? '/admin/dashboard' : '/commercial/dashboard' }}" style="display:flex;align-items:center;gap:10px">
      <img src="/images/logo.png" alt="NEXUS">
      <span>NEXUS</span>
    </a>
  </div>

  <div class="search">
    <i class="ti ti-search"></i>
    <input type="text" id="globalSearchInput" placeholder="Rechercher un contact, une entreprise, un utilisateur...">
    <span class="shortcut">⌘ K</span>
  </div>

  <div class="mode-toggle" title="Basculer le mode clair / sombre">
    <button type="button" class="active" onclick="window.toggleTheme('light')"><i class="ti ti-sun"></i> Mode clair</button>
    <button type="button" onclick="window.toggleTheme('dark')"><i class="ti ti-moon"></i> Mode sombre</button>
  </div>

  <div class="profile">
    <div class="avatar-initials">{{ auth.user ? auth.user.fullName.split(' ').map(n => n[0]).join('').toUpperCase() : 'U' }}</div>
    <div>
      <div class="name">{{ auth.user ? auth.user.fullName : 'Utilisateur' }}</div>
      <div class="role">{{ auth.user && auth.user.role === 'admin' ? 'Administrateur' : 'Commercial' }}</div>
    </div>
  </div>
</nav>